t;                    // Mark for ending on next clock&lt;br/&gt;                    arEnd = ptx;&lt;br/&gt;                }&lt;br/&gt;&lt;br/&gt;                // ========================================================================================================================&lt;br/&gt;                // Read Data Channel&lt;br/&gt;                // ========================================================================================================================&lt;br/&gt;&lt;br/&gt;                // Detect read data handshake (RVALID &amp;amp;&amp;amp; RREADY)&lt;br/&gt;                if (rvalid.isHigh() &amp;amp;&amp;amp; rready.isHigh()) {&lt;br/&gt;&lt;br/&gt;                    Pending ptx = null;&lt;br/&gt;&lt;br/&gt;                    // Find transaction&lt;br/&gt;                    int id = rid != null ? rid.intValue() : 0;&lt;br/&gt;                    for (Pending p : pending.values()) {&lt;br/&gt;                        if (p.u0 == id &amp;amp;&amp;amp; ITransaction.CMD_READ.equals(p.getCmd())) {&lt;br/&gt;                            ptx = p;&lt;br/&gt;                            break;&lt;br/&gt;                        }&lt;br/&gt;                    }&lt;br/&gt;                    if (ptx != null) {&lt;br/&gt;&lt;br/&gt;                        // Response&lt;br/&gt;                        int resp = rresp != null ? rresp.intValue() : 0;&lt;br/&gt;&lt;br/&gt;                        // Retrieve beats and bytes&lt;br/&gt;                        boolean isLast = rlast.isHigh();&lt;br/&gt;                        int bytesPerBeat = (int) ptx.u1;&lt;br/&gt;&lt;br/&gt;                        // Begin response data&lt;br/&gt;                        listener.beginRespBeat(null, current, ptx, !isLast, -bytesPerBeat, false, pending, resp);&lt;br/&gt;&lt;br/&gt;                        // log&lt;br/&gt;                        console.log(&amp;quot;Write Data&amp;quot;, id, isLast, resp);&lt;br/&gt;&lt;br/&gt;                        // Mark for ending on next clock&lt;br/&gt;                        rEnd = ptx;&lt;br/&gt;&lt;br/&gt;                    } else&lt;br/&gt;                        console.error(&amp;quot;Could not find transaction&amp;quot;);&lt;br/&gt;                }&lt;br/&gt;            }&lt;br/&gt;        }&lt;br/&gt;        &lt;br/&gt;        console.info(String.format(&amp;quot;AceAnalyzer.findPhases() - Completed %s transaction analysis&amp;quot;, axiVersion));&lt;br/&gt;        return true;&lt;br/&gt;    }&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;}</impl>
