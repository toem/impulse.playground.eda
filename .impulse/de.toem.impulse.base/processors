br/&gt;            p.certificate = Annotation.certificate;&lt;br/&gt;            p.impl = MultilineText.toXml(Bundles.getBundleSourceEntryAsString(AxiAnalyzer.class));&lt;br/&gt;            p.javaBundle = Utils.commarize(ImpulseBase.BUNDLE_ID, Bundles.getBundleId(AxiAnalyzer.class));&lt;br/&gt;            return p;&lt;br/&gt;        } catch (Throwable e) {&lt;br/&gt;        }&lt;br/&gt;        return null;&lt;br/&gt;    }&lt;br/&gt;&lt;br/&gt;    /**&lt;br/&gt;     * Determines if this analyzer is the default choice for the given context.&lt;br/&gt;     *&lt;br/&gt;     * @param context&lt;br/&gt;     *            The context to evaluate&lt;br/&gt;     * @return true if this analyzer should be the default for the context&lt;br/&gt;     */&lt;br/&gt;    public static boolean isDefault(Object context) {&lt;br/&gt;        if (context instanceof IReadableSamples) {&lt;br/&gt;&lt;br/&gt;        }&lt;br/&gt;        return false;&lt;br/&gt;    }&lt;br/&gt;&lt;br/&gt;    public static boolean updateAutoSources(ISamplesProcessorDescriptor descriptor, String configuration, String[][] properties,&lt;br/&gt;            Map&amp;lt;ICell, ICell&amp;gt; cells, Map&amp;lt;Object, IReadableSamples&amp;gt; sources, ISourceHandler sourceHandler) {&lt;br/&gt;        boolean result =  AbstractPinlevelAnalyzer.updateAutoSources(descriptor, configuration, getPropertyModel(descriptor, null), properties, cells, sources,&lt;br/&gt;                sourceHandler, AXI_SOURCES);&lt;br/&gt;        return checkMandatorySources(sources,null);&lt;br/&gt;    }&lt;br/&gt;&lt;br/&gt;    protected static boolean checkMandatorySources(Map pointers, IConsoleStream console) {&lt;br/&gt;        List&amp;lt;String&amp;gt; missingSignals = new ArrayList&amp;lt;&amp;gt;();&lt;br/&gt;&lt;br/&gt;        // Detect protocol version based on present signals&lt;br/&gt;        boolean hasWid = pointers.containsKey(WID);&lt;br/&gt;        boolean hasAxi4Signals = pointers.containsKey(AWQOS) || pointers.containsKey(ARQOS) || pointers.containsKey(AWREGION)&lt;br/&gt;                || pointers.containsKey(ARREGION);&lt;br/&gt;&lt;br/&gt;        boolean isAxi3 = hasWid;&lt;br/&gt;        boolean isAxi4 = !hasWid &amp;amp;&amp;amp; hasAxi4Signals;&lt;br/&gt;        String axiVersion = isAxi3 ? &amp;quot;AXI3&amp;quot; : (isAxi4 ? &amp;quot;AXI4&amp;quot; : &amp;quot;AXI3/4&amp;quot;);&lt;br/&gt;&lt;br/&gt;        // Clock is mandatory&lt;br/&gt;        if (!pointers.containsKey(ACLK))&lt;br/&gt;            missingSignals.add(ACLK);&lt;br/&gt;&lt;br/&gt;        // Write Address Channel mandatory signals&lt;br/&gt;        if (!pointers.containsKey(AWVALID))&lt;br/&gt;            missingSignals.add(AWVALID);&lt;br/&gt;        if (!pointers.containsKey(AWREADY))&lt;br/&gt;            missingSignals.add(AWREADY);&lt;br/&gt;&lt;br/&gt;        // Write Data Channel mandatory signals&lt;br/&gt;        // WID is mandatory only for AXI3&lt;br/&gt;        if (isAxi3 &amp;amp;&amp;amp; !pointers.containsKey(WID))&lt;br/&gt;            missingSignals.add(WID + &amp;quot; (required for AXI3)&amp;quot;);&lt;br/&gt;        if (!pointers.containsKey(WVALID))&lt;br/&gt;            missingSignals.add(WVALID);&lt;br/&gt;        if (!pointers.containsKey(WREADY))&lt;br/&gt;            missingSignals.add(WREADY);&lt;br/&gt;        if (!pointers.containsKey(WLAST))&lt;br/&gt;            missingSignals.add(WLAST);&lt;br/&gt;&lt;br/&gt;        // Check Write Response Channel mandatory signals&lt;br/&gt;        if (!pointers.containsKey(BVALID))&lt;br/&gt;            missingSignals.add(BVALID);&lt;br/&gt;        if (!pointers.containsKey(BREADY))&lt;br/&gt;            missingSignals.add(BREADY);&lt;br/&gt;&lt;br/&gt;        // Check Read Address Channel mandatory signals&lt;br/&gt;        if (!pointers.containsKey(ARVALID))&lt;br/&gt;            missingSignals.add(ARVALID);&lt;br/&gt;        if (!pointers.containsKey(ARREADY))&lt;br/&gt;            missingSignals.add(ARREADY);&lt;br/&gt;&lt;br/&gt;        //