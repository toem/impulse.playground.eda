ACTIONS || signal == SIGNAL_REQUESTS) {&lt;br/&gt;            // Protocol ID (AWID/ARID)&lt;br/&gt;            members.add(writer.createMember(null, &amp;quot;ID&amp;quot;, null, null, null, StructMember.DATA_TYPE_INTEGER, -1, ISample.FORMAT_HEXADECIMAL));&lt;br/&gt;&lt;br/&gt;            // Burst Type (AWBURST/ARBURST)&lt;br/&gt;            members.add(m = writer.createMember(null, &amp;quot;Burst&amp;quot;, null, null, null, StructMember.DATA_TYPE_ENUM, -1, ISample.FORMAT_DEFAULT));&lt;br/&gt;            m.setEnum(BURST_FIXED, &amp;quot;FIXED&amp;quot;);&lt;br/&gt;            m.setEnum(BURST_INCR, &amp;quot;INCR&amp;quot;);&lt;br/&gt;            m.setEnum(BURST_WRAP, &amp;quot;WRAP&amp;quot;);&lt;br/&gt;&lt;br/&gt;            // Burst Size (AWSIZE/ARSIZE) - bytes per beat&lt;br/&gt;            members.add(m = writer.createMember(null, &amp;quot;Size&amp;quot;, null, null, null, StructMember.DATA_TYPE_ENUM, -1, ISample.FORMAT_DEFAULT));&lt;br/&gt;            m.setEnum(0, &amp;quot;1 byte&amp;quot;);&lt;br/&gt;            m.setEnum(1, &amp;quot;2 bytes&amp;quot;);&lt;br/&gt;            m.setEnum(2, &amp;quot;4 bytes&amp;quot;);&lt;br/&gt;            m.setEnum(3, &amp;quot;8 bytes&amp;quot;);&lt;br/&gt;            m.setEnum(4, &amp;quot;16 bytes&amp;quot;);&lt;br/&gt;            m.setEnum(5, &amp;quot;32 bytes&amp;quot;);&lt;br/&gt;            m.setEnum(6, &amp;quot;64 bytes&amp;quot;);&lt;br/&gt;            m.setEnum(7, &amp;quot;128 bytes&amp;quot;);&lt;br/&gt;&lt;br/&gt;            // Lock Type (AWLOCK/ARLOCK)&lt;br/&gt;            members.add(m = writer.createMember(null, &amp;quot;Lock&amp;quot;, null, null, null, StructMember.DATA_TYPE_ENUM, -1, ISample.FORMAT_DEFAULT));&lt;br/&gt;            m.setEnum(0, &amp;quot;Normal&amp;quot;);&lt;br/&gt;            m.setEnum(1, &amp;quot;Exclusive&amp;quot;);&lt;br/&gt;&lt;br/&gt;            // Cache attributes (AWCACHE/ARCACHE) - 4-bit enumeration showing set flags&lt;br/&gt;            // Bit[3]: Read-Allocate, Bit[2]: