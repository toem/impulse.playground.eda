      boolean hasRxChannels = hasRxReqChannel || hasRxRspChannel || hasRxDatChannel || hasRxSnpChannel;&lt;br/&gt;&lt;br/&gt;        // Validate: need at least one complete direction (TX or RX) with minimal channels&lt;br/&gt;        if (!hasTxChannels &amp;amp;&amp;amp; !hasRxChannels) {&lt;br/&gt;            missingSignals.add(&amp;quot;At least one CHI channel (TX or RX) required&amp;quot;);&lt;br/&gt;        } else {&lt;br/&gt;            // Validate TX direction if any TX channel present&lt;br/&gt;            if (hasTxChannels) {&lt;br/&gt;                // For TX: need at least REQ channel&lt;br/&gt;                if (!hasTxReqChannel) {&lt;br/&gt;                    warnings.add(&amp;quot;TXREQ channel missing (TXREQFLITV/TXREQFLIT)&amp;quot;);&lt;br/&gt;                }&lt;br/&gt;                // For meaningful transactions: need either RSP or DAT&lt;br/&gt;                if (!hasTxRspChannel &amp;amp;&amp;amp; !hasTxDatChannel) {&lt;br/&gt;                    warnings.add(&amp;quot;No TX response channels (TXRSP/TXDAT) - transactions will be incomplete&amp;quot;);&lt;br/&gt;                }&lt;br/&gt;            }&lt;br/&gt;&lt;br/&gt;            // Validate RX direction if any RX channel present&lt;br/&gt;            if (hasRxChannels) {&lt;br/&gt;                // For RX: need at least REQ channel&lt;br/&gt;                if (!hasRxReqChannel) {&lt;br/&gt;                    warnings.add(&amp;quot;RXREQ channel missing (RXREQFLITV/RXREQFLIT)&amp;quot;);&lt;br/&gt;                }&lt;br/&gt;                // For meaningful transactions: need either RSP or DAT&lt;br/&gt;                if (!hasRxRspChannel &amp;amp;&amp;amp; !hasRxDatChannel) {&lt;br/&gt;                    warnings.add(&amp;quot;No RX response channels (RXRSP/RXDAT) - transactions will be incomplete&amp;quot;);&lt;br/&gt;                }&lt;br/&gt;            }&lt;br/&gt;        }&lt;br/&gt;&lt;br/&gt;        // Report issues&lt;br/&gt;        if (!missingSignals.isEmpty()) {&l