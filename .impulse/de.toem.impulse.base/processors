        <impl>package de.toem.impulse.extension.eda.transaction.chi;&lt;br/&gt;&lt;br/&gt;import java.util.ArrayList;&lt;br/&gt;import java.util.List;&lt;br/&gt;import java.util.Map;&lt;br/&gt;&lt;br/&gt;import de.toem.impulse.ImpulseBase;&lt;br/&gt;import de.toem.impulse.cells.processor.JavaSamplesProcessorPreference;&lt;br/&gt;import de.toem.impulse.extension.eda.transaction.chi.ChiFlitParser.ChiFlit;&lt;br/&gt;import de.toem.impulse.extension.eda.transaction.i18n.I18n;&lt;br/&gt;import de.toem.impulse.samples.IReadableSamples;&lt;br/&gt;import de.toem.impulse.samples.ISample;&lt;br/&gt;import de.toem.impulse.samples.ISamplePointer;&lt;br/&gt;import de.toem.impulse.samples.ISamplePointerIterator;&lt;br/&gt;import de.toem.impulse.samples.IStructSamplesWriter;&lt;br/&gt;import de.toem.impulse.samples.processor.ISamplesProcessorDescriptor;&lt;br/&gt;import de.toem.impulse.samples.processor.ISamplesProcessorDescriptor.ISourceHandler;&lt;br/&gt;import de.toem.impulse.samples.raw.StructMember;&lt;br/&gt;import de.toem.impulse.usecase.eda.transaction.AbstractPinlevelAnalyzer;&lt;br/&gt;import de.toem.impulse.usecase.eda.transaction.ITransaction;&lt;br/&gt;import de.toem.impulse.usecase.eda.transaction.ITransaction.PhasesListener;&lt;br/&gt;import de.toem.impulse.usecase.eda.transaction.ITransaction.PhasesListener.Pending;&lt;br/&gt;import de.toem.toolkits.core.Utils;&lt;br/&gt;import de.toem.toolkits.pattern.bundles.Bundles;&lt;br/&gt;import de.toem.toolkits.pattern.element.ICell;&lt;br/&gt;import de.toem.toolkits.pattern.ide.IConsoleStream;&lt;br/&gt;import de.toem.toolkits.pattern.properties.IPropertyModel;&lt;br/&gt;import de.toem.toolkits.pattern.registry.RegistryAnnotation;&lt;br/&gt;import de.toem.toolkits.pattern.threading.IProgress;&lt;br/&gt;import de.toem.toolkits.utils.text.MultilineText;&lt;br/&gt;&lt;br/&gt;/**&lt;br/&gt; * CHI (Coherent Hub Interface) Analyzer for impulse transaction-level analysis.&lt;br/&gt; *&lt;br/&gt; * This analyzer parses AMBA CHI protocol signals and converts them into high-level transaction records. CHI is ARM&amp;apos;s coherent interconnect protocol&lt;br/&gt; * used in modern SoC designs for cache-coherent communication between processors, accelerators, and memory controllers.&lt;br/&gt; *&lt;br/&gt; * Key features implemented by this analyzer: - Full CHI protocol state machine tracking across all five channels (REQ, RSP, DAT, SNP) - Support for&lt;br/&gt; * both CHI-B and CHI-H protocol versions with configurable parameters - Transaction threading via TxnID/SrcID/TgtID matching across channels -&lt;br/&gt; * Proper handling of read, write, atomic, CMO, and snoop transactions - Data beat tracking with automatic width detection from signal bit widths -&lt;br/&gt; * Forwarded snoop support with dual UID aliasing for proper response matching - Response error tracking (RespErr field) - Configurable node ID width&lt;br/&gt; * (7-16 bits), address width (44-52 bits), and RSVDC fields&lt;br/&gt; *&lt;br/&gt; * The analyzer processes five main CHI channels with bidirectional (TX/RX) variants: - REQ Channel: Request flits initiating transactions (reads,&lt;br/&gt; * writes, CMOs) - RSP Channel: Response flits providing DBID grants and completion acknowledgments - DAT Channel: Data flits carrying read/write&lt;br/&gt; * payload and CompData responses - SNP Channel: Snoop request flits for cache coherency maintenance - Each channel operates independently with&lt;br/&gt; * FlitV/Flit/LCrdV handshake signals&lt;br/&gt; *&lt;br/&gt; * Transaction matching uses multi-channel correlation: - Request phase: REQ flit creates transaction with SrcID+TxnID as UID - DBID response: RSP&lt;br/&gt; * flit matches via TgtID+TxnID (TgtID echoes original SrcID) - Data phase: DAT flit matches via SrcID+TxnID (writes) or TgtID+TxnID (reads) -&lt;br/&gt; * Completion: RSP Comp flit matches via TgtID+TxnID - Snoops: SNP flit creates transaction, SnpResp/SnpRespData responses match via TgtID+TxnID -&lt;br/&gt; * Forwarded snoops use dual UID aliasing (original + FwdNID+FwdTxnID) for proper data routing&lt;br/&gt; *&lt;br/&gt; * Implementation Notes: - Operates on rising clock edges with optional active-low reset handling - Automatically calculates data beats from transfer&lt;br/&gt; * size and detected data bus width - Supports posted writes (ExpCompAck=0) that complete after data phase - Non-posted writes wait for Comp response&lt;br/&gt; * before transaction completion - Read transactions wait for all CompData beats before completion - Snoop transactions support both data and non-data&lt;br/&gt; * responses&lt;br/&gt; *&lt;br/&gt; * Copyright (c) 2013-2025 Thomas Haber All rights reserved.&lt;br/&gt; */&lt;br/&gt;@RegistryAnnotation(annotation = ChiAnalyzer.Annotation.class)&lt;br/&gt;public class ChiAnalyzer extends AbstractPinlevelAnalyzer {&lt;br/&gt;&lt;br/&gt;    public static class Annotation {&lt;br/&gt;&lt;br/&gt;        public static final String id = &amp;quot;de.toem.impulse.processor.chiAnalyzer&amp;quot;;&lt;br/&gt;        public static final String label = I18n.Processor_ChiAnalyzer;&lt;br/&gt;        public static final String description = I18n.Processor_ChiAnalyzer_Description;&lt;br/&gt;        public static final String iconId = I18n.Processor_ChiAnalyzer_IconId;&lt;br/&gt;        public static final String helpURL = I18n.Processor_ChiAnalyzer_HelpURL;&lt;br/&gt;        public static final String certificate = &amp;quot;bQkQG7vJ2rQrdmEuI1674j3Qi9eY1UGD\nVhODxCEfY7ExnE2ylazpEwuuq2EVmdJT\nucEnDOe7QJEU6uVBl8aJVTRGMZxjJjns\niFOGiXJHy14HviueknU5D55WT/dg+S7O\nNTgeXLjBPXS8gPZLO94dJ2Sw7mH2xpvu\ngvx8HlqqzpeYDxz+5fm1jS7cOQ+pEH1v\nzfRVBB5ZwoTho2+5weq52z2q/4C5axaO\nmgZEiPcF9WKNAB1PCG9tzTIXE7oJEKaN\nqjUY706TCw9QNKJJ4TALfpoJKHxolqQ9\nfnmAT38+IuIAy5w0YnikC+9oYBN7Geii\n8PB+QH711TKzjOoNc01TDHP3P3Wi3CLp\nXrw5EH/oMdsOJyctNUwSzg==\n&amp;quot;;&lt;br/&gt;    }&lt;br/&gt;&lt;br/&gt;    // =================================================================================================